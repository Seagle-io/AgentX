{
	"name": "salle-v2-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --strictPort",
		"build": "tsc -p tsconfig.app.json --noEmit && vite build",
		"preview": "vite preview",
		"lint": "biome check src && node scripts/check-fetch.mjs",
		"format": "biome format --write src",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@tanstack/react-query": "5.104.3",
		"clsx": "2.1.1",
		"i18next": "26.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-i18next": "17.0.18",
		"react-router": "8.4.0",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.7",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
